<!--
  Panel, Button, ButtonIcon, and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles and LogIn are bundled Lucide icon components. The :dark
  styles apply because iwsdk.config.json prefers the dark color scheme.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 420px;
  }

  .panel-content {
    flex-direction: column;
    gap: 7px;
    padding: 22px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
    line-height: 36px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 20px;
    line-height: 27px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .note {
    color: #6b5a00;
    font-size: 17px;
    line-height: 24px;
    margin-top: 6px;
  }

  .note:dark {
    color: #f5d90a;
  }

  .button {
    justify-content: flex-start;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">LUCKY BREAK - SCENE 1</div>
    <div class="heading">"You! Lighting! Make the talent look good."</div>
    <div class="body">Pick a light from the kit, move it past the</div>
    <div class="body">tape, and match the target on the monitor.</div>
    <div id="desktop-help" class="body">Drag a light to move it. Scroll while dragging</div>
    <div id="desktop-help-2" class="body">to raise it. Drag empty space to turn the set.</div>
    <div id="headset-note" class="note">On a Quest? Open this page in its browser.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Play in your room</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
